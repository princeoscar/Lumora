generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(cuid())
  clerkId                  String               @unique
  email                    String               @unique
  username                 String?              @unique
  role                     UserRole             @default(USER)
  accountStatus            AccountStatus        @default(PENDING)
  verificationStatus       VerificationStatus   @default(UNVERIFIED)
  emailVerified            Boolean              @default(false)
  onboardingCompleted      Boolean              @default(false)
  lastActiveAt             DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?
  media                    UserMedia[]
  profile                  UserProfile?
  discoveryPreference      DiscoveryPreference?
  interests                UserInterest[]
  prompts                  UserPrompt[]
  sentDiscoveryActions     DiscoveryAction[]    @relation("DiscoveryActionActor")
  receivedDiscoveryActions DiscoveryAction[]    @relation("DiscoveryActionTarget")
  matchesAsUser            Match[]              @relation("MatchUser")
  matchesAsMatchedUser     Match[]              @relation("MatchMatchedUser")
  messagesSent             Message[]            @relation("MessageSender")

  @@index([email])
  @@index([username])
  @@index([accountStatus])
}

model UserProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  displayName       String?
  firstName         String
  lastName          String?
  dateOfBirth       DateTime
  gender            Gender
  bio               String?           @db.VarChar(500)
  occupation        String?
  company           String?
  height            Int?
  profileVisibility ProfileVisibility @default(PUBLIC)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender])
}

model Interest {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  users     UserInterest[]
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model UserPrompt {
  id           String   @id @default(cuid())
  userId       String
  prompt       String   @db.VarChar(200)
  response     String   @db.VarChar(500)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
}

model DiscoveryPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  minAge              Int      @default(18)
  maxAge              Int      @default(100)
  interestedInGenders Gender[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscoveryAction {
  id           String              @id @default(cuid())
  userId       String
  targetUserId String
  action       DiscoveryActionType
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user   User @relation("DiscoveryActionActor", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("DiscoveryActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId, action])
  @@index([targetUserId, action])
}

model Match {
  id            String   @id @default(cuid())
  userId        String
  matchedUserId String
  createdAt     DateTime @default(now())

  user        User      @relation("MatchUser", fields: [userId], references: [id], onDelete: Cascade)
  matchedUser User      @relation("MatchMatchedUser", fields: [matchedUserId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([userId, matchedUserId])
  @@index([userId, createdAt])
  @@index([matchedUserId, createdAt])
}

model Message {
  id        String    @id @default(cuid())
  matchId   String
  senderId  String
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?
  readAt    DateTime?

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([senderId, createdAt])
}

model UserMedia {
  id             String    @id @default(cuid())
  userId         String
  url            String
  publicId       String
  mediaType      MediaType @default(IMAGE)
  isProfilePhoto Boolean   @default(false)
  isVerified     Boolean   @default(false)
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
  @@index([mediaType])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  PREMIUM_ONLY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum DiscoveryActionType {
  LIKE
  PASS
}

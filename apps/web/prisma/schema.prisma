generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(cuid())
  clerkId                  String               @unique
  email                    String               @unique
  username                 String?              @unique
  role                     UserRole             @default(USER)
  accountStatus            AccountStatus        @default(PENDING)
  verificationStatus       VerificationStatus   @default(UNVERIFIED)
  verifications             Verification[]
  emailVerified            Boolean              @default(false)
  onboardingCompleted      Boolean              @default(false)
  lastActiveAt             DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?
  media                    UserMedia[]
  profile                  UserProfile?
  location             UserLocation?
  lifestyle            UserLifestyle?
  settings             UserSettings?
  discoveryPreference      DiscoveryPreference?
  interests                UserInterest[]
  prompts                  UserPrompt[]
  subscriptions            Subscription[]
  payments Payment[]
  premiumUsages PremiumUsage[]
  sentDiscoveryActions     DiscoveryAction[]    @relation("DiscoveryActionActor")
  receivedDiscoveryActions DiscoveryAction[]    @relation("DiscoveryActionTarget")
  matchesAsUser            Match[]              @relation("MatchUser")
  matchesAsMatchedUser     Match[]              @relation("MatchMatchedUser")
  messagesSent             Message[]            @relation("MessageSender")

  @@index([email])
  @@index([username])
  @@index([accountStatus])
}

model Verification {
  id              String             @id @default(cuid())
  userId          String
  type            VerificationType
  status          VerificationReviewStatus @default(PENDING)

  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  expiresAt       DateTime?

  rejectionReason String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence        VerificationEvidence[]

  @@index([userId, status])
  @@index([userId, type])
  @@index([status])
}

enum VerificationEvidenceType {
  SELFIE
  IDENTITY_DOCUMENT
}

model VerificationEvidence {
  id             String                   @id @default(cuid())
  verificationId String

  type           VerificationEvidenceType

  publicId       String
  resourceType   String                   @default("image")
  mimeType       String?
  fileSize       Int?

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  verification   Verification             @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
  @@index([verificationId, type])
}

model UserProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  displayName       String?
  firstName         String
  lastName          String?
  dateOfBirth       DateTime
  gender            Gender
  bio               String?           @db.VarChar(500)
  occupation        String?
  company           String?
  height            Int?
  profileVisibility ProfileVisibility @default(PUBLIC)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender])
}

model UserLocation {
  id            String   @id @default(cuid())
  userId        String   @unique

  city          String?
  state         String?
  country       String?
  countryCode   String?

  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)

  isApproximate Boolean  @default(true)
  lastUpdatedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode])
  @@index([city])
}

model UserLifestyle {
  id                 String              @id @default(cuid())
  userId             String              @unique

  smoking            LifestyleFrequency?
  drinking           LifestyleFrequency?
  cannabis           LifestyleFrequency?
  childrenStatus     ChildrenStatus?
  childrenPreference ChildrenPreference?
  pets               PetPreference?
  diet               DietPreference?
  exercise           LifestyleFrequency?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique

  pushNotifications      Boolean  @default(true)
  emailNotifications     Boolean  @default(true)
  matchNotifications     Boolean  @default(true)
  messageNotifications   Boolean  @default(true)
  marketingNotifications Boolean  @default(false)

  readReceipts           Boolean  @default(true)
  showOnlineStatus       Boolean  @default(true)

  language               String   @default("en")
  timezone               String   @default("UTC")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Interest {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  users     UserInterest[]
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model UserPrompt {
  id           String   @id @default(cuid())
  userId       String
  prompt       String   @db.VarChar(200)
  response     String   @db.VarChar(500)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
}

model DiscoveryPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  minAge              Int      @default(18)
  maxAge              Int      @default(100)
  interestedInGenders Gender[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscoveryAction {
  id           String              @id @default(cuid())
  userId       String
  targetUserId String
  action       DiscoveryActionType
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user   User @relation("DiscoveryActionActor", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("DiscoveryActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId, action])
  @@index([targetUserId, action])
}

model Match {
  id            String   @id @default(cuid())
  userId        String
  matchedUserId String
  createdAt     DateTime @default(now())

  user        User      @relation("MatchUser", fields: [userId], references: [id], onDelete: Cascade)
  matchedUser User      @relation("MatchMatchedUser", fields: [matchedUserId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([userId, matchedUserId])
  @@index([userId, createdAt])
  @@index([matchedUserId, createdAt])
}

model Message {
  id        String    @id @default(cuid())
  matchId   String
  senderId  String
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?
  readAt    DateTime?

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([senderId, createdAt])
}

model UserMedia {
  id             String    @id @default(cuid())
  userId         String
  url            String
  publicId       String
  mediaType      MediaType @default(IMAGE)
  isProfilePhoto Boolean   @default(false)
  isVerified     Boolean   @default(false)
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
  @@index([mediaType])
}

model PremiumPlan {
  id              String                 @id @default(cuid())
  name            String
  slug            String                 @unique
  description     String?
  price           Decimal                @db.Decimal(10, 2)
  currency        String                 @default("NGN")
  billingInterval PremiumBillingInterval
  isActive        Boolean                @default(true)
  subscriptions Subscription[]
  payments Payment[]
  entitlements PremiumEntitlement[]

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  premiumPlanId      String

  status             SubscriptionStatus @default(ACTIVE)

  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)

  provider           String?
  providerId         String?            @unique

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  premiumPlan        PremiumPlan @relation(fields: [premiumPlanId], references: [id], onDelete: Restrict)
  payments           Payment[]

  @@index([userId, status])
  @@index([premiumPlanId])
  @@index([currentPeriodEnd])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  premiumPlanId  String
  subscriptionId String?

  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("NGN")
  status         PaymentStatus @default(PENDING)

  provider       String?
  providerId     String?       @unique

  paidAt         DateTime?
  refundedAt     DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  premiumPlan  PremiumPlan  @relation(fields: [premiumPlanId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([premiumPlanId])
  @@index([subscriptionId])
  @@index([status])
}

model PremiumEntitlement {
  id            String          @id @default(cuid())
  premiumPlanId String
  type          EntitlementType
  isEnabled     Boolean         @default(true)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  premiumPlan PremiumPlan @relation(fields: [premiumPlanId], references: [id], onDelete: Cascade)

  @@unique([premiumPlanId, type])
  @@index([premiumPlanId])
  @@index([type])
}

model PremiumUsage {
  id          String           @id @default(cuid())
  userId      String
  type        PremiumUsageType

  usageCount  Int              @default(0)
  usageLimit  Int?

  periodStart DateTime
  periodEnd   DateTime

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodStart])
  @@index([userId, type])
  @@index([periodEnd])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  PREMIUM_ONLY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum VerificationReviewStatus  {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationType {
  PROFILE
  IDENTITY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum DiscoveryActionType {
  LIKE
  PASS
}

enum LifestyleFrequency {
  NEVER
  SOMETIMES
  OFTEN
  REGULARLY
}

enum ChildrenStatus {
  HAVE_CHILDREN
  NO_CHILDREN
}

enum ChildrenPreference {
  WANT_CHILDREN
  DONT_WANT_CHILDREN
  OPEN_TO_CHILDREN
  NOT_SURE
}

enum PetPreference {
  HAVE_PETS
  LOVE_PETS
  LIKE_PETS
  NO_PETS
  NOT_A_FAN
}

enum DietPreference {
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  HALAL
  KOSHER
  OTHER
  PREFER_NOT_TO_SAY
}

enum PremiumBillingInterval {
  MONTH
  YEAR
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum EntitlementType {
  UNLIMITED_LIKES
  SEE_WHO_LIKED_YOU
  SUPER_LIKE
  BOOST
  ADVANCED_FILTERS
  INCOGNITO_MODE
  READ_RECEIPTS
  PREMIUM_PROFILE_ACCESS
}

enum PremiumUsageType {
  LIKE
  SUPER_LIKE
  BOOST
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
  PAUSED
}


generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(cuid())
  clerkId                  String               @unique
  email                    String               @unique
  username                 String?              @unique
  role                     UserRole             @default(USER)
  accountStatus            AccountStatus        @default(PENDING)
  verificationStatus       VerificationStatus   @default(UNVERIFIED)
  emailVerified            Boolean              @default(false)
  onboardingCompleted      Boolean              @default(false)
  lastActiveAt             DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?
  media                    UserMedia[]
  profile                  UserProfile?
  discoveryPreference      DiscoveryPreference?
  sentDiscoveryActions     DiscoveryAction[]    @relation("DiscoveryActionActor")
  receivedDiscoveryActions DiscoveryAction[]    @relation("DiscoveryActionTarget")

  @@index([email])
  @@index([username])
  @@index([accountStatus])
}

model UserProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  displayName       String?
  firstName         String
  lastName          String?
  dateOfBirth       DateTime
  gender            Gender
  bio               String?           @db.VarChar(500)
  occupation        String?
  company           String?
  height            Int?
  profileVisibility ProfileVisibility @default(PUBLIC)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender])
}

model DiscoveryPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  minAge              Int      @default(18)
  maxAge              Int      @default(100)
  interestedInGenders Gender[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscoveryAction {
  id           String              @id @default(cuid())
  userId       String
  targetUserId String
  action       DiscoveryActionType
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user   User @relation("DiscoveryActionActor", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("DiscoveryActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId, action])
  @@index([targetUserId, action])
}

model UserMedia {
  id             String    @id @default(cuid())
  userId         String
  url            String
  publicId       String
  mediaType      MediaType @default(IMAGE)
  isProfilePhoto Boolean   @default(false)
  isVerified     Boolean   @default(false)
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
  @@index([mediaType])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  PREMIUM_ONLY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum DiscoveryActionType {
  LIKE
  PASS
}

{
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "^17.6.0"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm --filter web exec eslint --fix",
      "pnpm --filter web exec prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "pnpm --filter web exec prettier --write"
    ]
  }
}
